{{- /*
  Custom override of Hugo's built-in RSS template. Structurally identical
  to Hugo's default output (verified against the site's own prior RSS
  output before this change) — the only behavioral difference is the
  {{ if not .Date.IsZero }} guard below. Pages with no meaningful
  publication date (About, Contact, AI GenMat) are excluded from items
  entirely rather than leaking Hugo's zero-date default (0001-01-01) as
  an invalid pubDate. Pages that do have real dates (every Blog post,
  every Project) are completely unaffected.
*/ -}}
{{ "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.Title }}</title>
  <link>{{ .Permalink }}</link>
  <description>Recent content on {{ site.Title }}</description>
  <generator>Hugo</generator>
  <language>{{ site.LanguageCode | default "en-us" }}</language>
  {{- with site.Lastmod }}
  <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
  {{- end }}
  {{- with .OutputFormats.Get "RSS" }}
  <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType }}"/>
  {{- end }}
  {{- range site.RegularPages }}
  {{- if not .Date.IsZero }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
    <guid>{{ .Permalink }}</guid>
    <description>{{ (.Params.summary | default .Summary | default "") | plainify }}</description>
  </item>
  {{- end }}
  {{- end }}
</channel>
</rss>
